{
  "name": "lambda-serverless-api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:ingest && pnpm run build:worker",
    "build:ingest": "esbuild src/ingest/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=build/ingest/index.cjs",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=build/worker/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1139.0",
    "@aws-sdk/client-eventbridge": "^3.1139.0",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
